# ------------------------------------------------------------------
# Build output & caches (regenerated by Gradle/Android Studio/NDK)
# ------------------------------------------------------------------
.gradle/
.kotlin/
build/
app/build/
app/.cxx/
captures/
*.apk
*.aab
*.ap_
*.dex

# ------------------------------------------------------------------
# Local machine config (paths differ per machine, regenerated)
# ------------------------------------------------------------------
/local.properties

# ------------------------------------------------------------------
# Signing secrets, NEVER commit these
# keystore.properties holds the passwords; the .jks is the private key.
# Copy keystore.properties.example to keystore.properties and fill in.
# ------------------------------------------------------------------
keystore.properties
*.jks
*.keystore
*.p12

# ------------------------------------------------------------------
# IDE / OS cruft
# ------------------------------------------------------------------
.idea/
*.iml
.DS_Store
Thumbs.db

# ------------------------------------------------------------------
# Vendored third-party: whisper.cpp is committed as plain source, but
# never its upstream git metadata (the .git dir
# is removed from the tree, see THIRD_PARTY_NOTICES.md for the pin).
# ------------------------------------------------------------------
app/src/main/cpp/whisper.cpp/.git/
