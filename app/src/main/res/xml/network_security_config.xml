<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: no cleartext to the internet. Every subtitle/translation source the app
         uses is HTTPS; only the two exceptions below are allowed to use plain HTTP. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- loopback MKV stream: ffmpeg reads http://127.0.0.1:<port>/video from the
             in-process torrent server (never leaves the device) -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- BSPlayer's legacy XML-RPC API offers no TLS endpoint (tier-3 last resort) -->
        <domain includeSubdomains="true">bsplayer-subtitles.com</domain>
    </domain-config>
</network-security-config>
