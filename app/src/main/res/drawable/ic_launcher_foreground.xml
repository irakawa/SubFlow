<?xml version="1.0" encoding="utf-8"?>
<!--
  SubFlow markası — "Akan Altyazı":
  İki altyazı satırı + akışa dönüşen üçüncü satır.
  Üst: kısa altın satır · Orta: uzun beyaz satır (asıl altyazı)
  Alt: yukarı kıvrılarak "akan" altın satır — SubFlow'un F'si gibi
  Flat, tipografik, tek bakışta okunur.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Üst satır — altın -->
    <path
        android:pathData="M34.5,42 L60.5,42"
        android:strokeWidth="6.2"
        android:strokeLineCap="round"
        android:strokeColor="#C8A96E"
        android:fillColor="#00000000" />

    <!-- Orta satır — beyaz, asıl altyazı -->
    <path
        android:pathData="M34.5,55 L74.5,55"
        android:strokeWidth="6.2"
        android:strokeLineCap="round"
        android:strokeColor="#F2F2F2"
        android:fillColor="#00000000" />

    <!-- Alt satır — akışa dönüşen kıvrım -->
    <path
        android:pathData="M34.5,68 L53,68 Q65.5,68 70.5,60"
        android:strokeWidth="6.2"
        android:strokeLineCap="round"
        android:strokeColor="#C8A96E"
        android:fillColor="#00000000" />
</vector>
