# Release signing credentials. Copy this to keystore.properties (git-ignored) and fill in.
#
#   cp keystore.properties.example keystore.properties
#
# Without it the release build still runs, just unsigned.
# storeFile is relative to the app/ module.

storeFile=subflow-release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
